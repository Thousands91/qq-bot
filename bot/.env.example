# ============== NoneBot ==============
# NoneBot 本身会自动通过环境变量加载 .env，建议以下变量都填一下
ENVIRONMENT=prod

# ============== OneBot (go-cqhttp) 连接 ==============
# 这里反向 WebSocket 要跟 go-cqhttp 的 config.yml 对应
ONEBOT_WS_URL=ws://127.0.0.1:8080/onebot/v11/ws
ONEBOT_API_URL=http://127.0.0.1:8080/onebot/v11
ONEBOT_ACCESS_TOKEN=

# ============== 超级用户 / Bot 自身 QQ ==============
# 用你自己的 QQ 在小号聊天窗口发 /whoami 可以查到
SUPERUSERS=
BOT_QQ=

# ============== AI 大模型（OpenAI 兼容协议） ==============
# 推荐国内服务：硅基流动 / DeepSeek / 智谱 / 月之暗面 / 豆包 等
# 只要兼容 openai sdk，base_url 一换就能用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# ============== 天气 ==============
# 免费：和风天气 https://dev.qweather.com
QWEATHER_KEY=
QWEATHER_API_HOST=https://devapi.qweather.com

# ============== 搜图（可选） ==============
# Lolicon API（搜色图）需自备 token；如不需要可忽略
LOLICON_TOKEN=

# ============== 行为开关 ==============
# 是否启用入群欢迎
ENABLE_WELCOME=true
# 是否启用关键词自动回复
ENABLE_KEYWORD_REPLY=true
# 是否启用 AI 问答
ENABLE_AI_CHAT=true
# AI 回复的最大 token 数
AI_MAX_TOKENS=800
# 单次会话上下文保留多少条（默认 6：3 轮对话）
AI_CONTEXT_LENGTH=6
