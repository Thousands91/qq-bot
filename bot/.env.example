# ============== NoneBot ==============
ENVIRONMENT=prod

# ============== OneBot (go-cqhttp) 连接 ==============
# 需与 cqhttp/config.yml 的反向 WS 地址一致
ONEBOT_WS_URL=ws://127.0.0.1:8080/onebot/v11/ws

# ============== 超级用户 / Bot 自身 QQ ==============
# 机器人 QQ 号（小号），可留空
BOT_QQ=

# ============== AI 大模型（阿萨尔人格的大脑） ==============
# 推荐 硅基流动 https://cloud.siliconflow.cn 注册送额度
# 其它：DeepSeek / 智谱 / 豆包 / 月之暗面（只改 BASE_URL 与 MODEL 即可）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 阿萨尔话不多，500 足够；想让他多说可调高
AI_MAX_TOKENS=500
# 上下文保留条数（6 = 3 轮对话）
AI_CONTEXT_LENGTH=6
# 温度，越高越发散。0.85 比较贴合"文雅但有脾气"的书商
AI_TEMPERATURE=0.85

# ============== 天气（可选） ==============
# 免费申请：https://dev.qweather.com
QWEATHER_KEY=
QWEATHER_API_HOST=https://devapi.qweather.com

# ============== 功能开关 ==============
ENABLE_AI_CHAT=true
ENABLE_KEYWORD_REPLY=true

# ============== 搜图（可选） ==============
LOLICON_TOKEN=
